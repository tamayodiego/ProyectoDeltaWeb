# Copy to backend/.env (ignored by git) and fill in. Every setting is in
# src/deltaweb/config.py; any of them can go here with the DELTAWEB_ prefix.

# Log in with GitHub: Settings > Developer settings > OAuth Apps
# Callback: http://localhost:8000/auth/oauth/github/callback
DELTAWEB_GITHUB_CLIENT_ID=
DELTAWEB_GITHUB_CLIENT_SECRET=

# Log in with Google: console.cloud.google.com > APIs & Services > Credentials
# Redirect URI: http://localhost:8000/auth/oauth/google/callback
DELTAWEB_GOOGLE_CLIENT_ID=
DELTAWEB_GOOGLE_CLIENT_SECRET=
